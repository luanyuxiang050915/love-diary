# ===== 服务器（正式/测试环境）用这个 =====
DATABASE_URL=postgresql+psycopg://loveuser:改成你的数据库密码@服务器IP/love_diary

# ===== 本地自测用这个（一行切换，把上面那行注释掉，取消下面这行注释）=====
# DATABASE_URL=sqlite:///./dev.db

# JWT 密钥：用下面命令生成随机字符串填进来
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=改成随机字符串

# 登录令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
